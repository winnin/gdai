GDAI_LOG_LEVEL=DEBUG                       # Logging level (e.g., DEBUG, INFO, WARNING, ERROR)
GDAI_LOG_FORMAT=[%(asctime)s] [GDAI] [%(levelname)s]: %(message)s   # Format for log messages
GDAI_LOG_FILE_ENABLED=false                # Enable logging to file (true/false)
GDAI_LOG_FILE_PATH=PROJECT_PATH/gdai/logs/gdai.log   # Path to the log file
GDAI_LOG_FILE_MAX_SIZE_MB=10               # Maximum log file size in megabytes before rotation
GDAI_LOG_FILE_BACKUP_COUNT=5               # Number of backup log files to keep

DATABASE=pgvector                          # Database type (e.g., pgvector or turso)
PGVECTOR_USER=testuser                     # Username for pgvector database
PGVECTOR_PASSWORD=testpwd                  # Password for pgvector database
PGVECTOR_DATABASE=vectordb                 # Name of the pgvector database
PGVECTOR_HOST=localhost                    # Host for pgvector database
PGVECTOR_PORT=5555                         # Port for pgvector database
PGVECTOR_MIN_POOL_CONNECTIONS=2            # Minimum number of database connections in pool
PGVECTOR_MAX_POOL_CONNECTIONS=10           # Maximum number of database connections in pool

S3_ENDPOINT=http://localhost:9000           # S3/MinIO endpoint URL
S3_ACCESS_KEY=minioadmin                    # S3/MinIO access key
S3_SECRET_KEY=minioadmin                    # S3/MinIO secret key
S3_BUCKET=gdai-documents                    # S3/MinIO bucket name for document storage
S3_REGION=us-east-1                         # S3 region (use us-east-1 for MinIO)
S3_USE_SSL=false                            # Use SSL for S3 connections (false for local MinIO)

EXTRACTOR_TMP_FOLDER=/tmp/gdai              # Temporary folder for file processing during extraction
EXTRACTOR_MAX_FILE_SIZE_MB=100              # Maximum file size (MB) for extraction
EXTRACTOR_MAX_RETRIES=3                     # Maximum retry attempts for extraction

EMBEDDING_MAX_TEXT_SIZE=5000                # Maximum text size for embedding
EMBEDDING_MAX_RETRIES=3                     # Max retries for embedding tasks
EMBEDDING_MODEL=cohere/embed-v4.0           # Embedding model to use
EMBEDDING_API_KEY=your-cohere-api-key       # API key for embedding service (previously EMBEDDING_MODEL_API_KEY)
EMBEDDING_DIMENSION=1536                    # Embedding dimension (required)
EMBEDDING_BATCH_SIZE=96                     # Batch size for embedding requests


LLM_MODEL=openai/gpt-4o                     # LLM model to use
LLM_API_KEY=your-openai-api-key             # API key for LLM service
LLM_MAX_TOKENS=2000                         # Max tokens for LLM responses
LLM_TEMPERATURE=0.7                         # Temperature for LLM responses (controls randomness)
